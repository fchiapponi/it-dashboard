# Database (path is resolved relative to prisma/schema.prisma, so this
# resolves to prisma/dev.db — do not add a "prisma/" prefix here)
DATABASE_URL="file:./dev.db?connection_limit=1&socket_timeout=20"

# Public URL people open the app at — used to build the Google redirect URI
# and the links inside QR labels. No trailing slash.
APP_URL="http://localhost:3060"

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials >
# OAuth client ID > Web application). Authorized redirect URI:
#   <APP_URL>/api/auth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Only accounts from this Google Workspace domain can sign in
GOOGLE_WORKSPACE_DOMAIN="tasis.ch"

# Comma-separated emails that become admins on their first sign-in
ADMIN_EMAILS=""

# Tickets by email (optional — see "Tickets by email" in the README).
# Mail sent to this mailbox becomes a ticket, sorted by AI.
TICKET_MAILBOX=""                 # e.g. ticket@tasis.ch
TICKET_MAILBOX_NAME="TASIS Helpdesk"
# Service account JSON key with domain-wide delegation for the Gmail scope
# https://www.googleapis.com/auth/gmail.modify. Keep it outside the repo.
GOOGLE_SERVICE_ACCOUNT_FILE=""
EMAIL_POLL_SECONDS="60"
# Department used when the AI can't sort an email (by slug)
EMAIL_TICKETS_DEFAULT_DEPARTMENT="it"
# Claude API key (console.anthropic.com) used to sort incoming emails
ANTHROPIC_API_KEY=""

# Printers: the app asks each printer at the asset's "IP address"
# field over SNMP (UDP port 161). Change only if the printers don't use "public".
PRINTER_SNMP_COMMUNITY="public"
# How often every printer is re-read (toner levels, page counts), in minutes
PRINTER_REFRESH_MINUTES="60"

# Dining dashboard: the kitchen's Google Sheet of daily meal counts. Use the ID
# from its link (docs.google.com/spreadsheets/d/<ID>/edit). The sheet must be
# shared as "Anyone with the link can view". Leave empty to hide the data.
DINING_SHEET_ID=""
# How often the sheet is re-read in the background, in hours ("Refresh now"
# on the Dining page re-reads it straight away)
DINING_REFRESH_HOURS="6"
