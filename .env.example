# Database (path is resolved relative to prisma/schema.prisma, so this
# resolves to prisma/dev.db — do not add a "prisma/" prefix here)
DATABASE_URL="file:./dev.db?connection_limit=1&socket_timeout=20"

# Printer polling interval (milliseconds)
PRINTER_POLL_INTERVAL_MS=60000

# Camera polling interval (milliseconds)
CAMERA_POLL_INTERVAL_MS=60000

# Server reachability polling interval (milliseconds)
SERVER_POLL_INTERVAL_MS=60000

# Key used to encrypt credentials stored in the database (SNMP community, camera passwords)
CREDENTIALS_ENCRYPTION_KEY=""

# Cisco Meraki Dashboard API (My profile > API access, in the Meraki dashboard)
MERAKI_API_KEY=""
MERAKI_ORG_ID=""
